  {
    "id": "api-status",
    "type": "js-function",
    "title": "API: код ответа",
    "prompt": "Функция httpStatus({authorized, found, method}) возвращает число: 401 если !authorized; 404 если authorized и !found; 200 если GET и found; 201 если POST и found-создание (found=true означает успех создания); иначе 405.",
    "difficulty": "medium",
    "timeLimitSec": 540,
    "starter": "function httpStatus({ authorized, found, method }) {\n  // напиши решение\n}\n",
    "functionName": "httpStatus",
    "tests": [
      {
        "name": "unauthorized",
        "args": [
          {
            "authorized": false,
            "found": true,
            "method": "GET"
          }
        ],
        "expected": 401
      },
      {
        "name": "not found",
        "args": [
          {
            "authorized": true,
            "found": false,
            "method": "GET"
          }
        ],
        "expected": 404
      },
      {
        "name": "get ok",
        "args": [
          {
            "authorized": true,
            "found": true,
            "method": "GET"
          }
        ],
        "expected": 200
      },
      {
        "name": "post create",
        "args": [
          {
            "authorized": true,
            "found": true,
            "method": "POST"
          }
        ],
        "expected": 201
      },
      {
        "name": "method",
        "args": [
          {
            "authorized": true,
            "found": true,
            "method": "PUT"
          }
        ],
        "expected": 405
      }
    ]
  },

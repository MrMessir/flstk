# Публичный URL сайта (prod / preview). Нужен для auth redirect.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Новый формат ключей Supabase (Dashboard → API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Дубли для клиента Next (обязательно на Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Этот email после входа / seed станет admin + pro
ADMIN_EMAIL=you@example.com
# Обязателен для npm run seed:admin — мин. 12 символов, без дефолта в скрипте
ADMIN_PASSWORD=replace-with-a-long-password

# Лимит бесплатных дуэлей в сутки
FREE_DUEL_DAILY_LIMIT=3

# Опционально: общий rate-limit на Vercel (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

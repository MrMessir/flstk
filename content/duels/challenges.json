        "expected": [
          {
            "id": "1",
            "title": "Mouse",
            "price": 1
          }
        ]
      },
      {
        "name": "пусто",
        "args": [
          [
            {
              "id": "1",
              "title": "A",
              "price": 1
            }
          ],
          "zzz"
        ],
        "expected": []
      }

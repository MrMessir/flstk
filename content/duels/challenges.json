    "tests": [
      {
        "name": "abc",
        "args": [
          "abc"
        ],
        "expected": "cba"
      },
      {
        "name": "пусто",
        "args": [
          ""
        ],
        "expected": ""
      },
      {
        "name": "один символ",
        "args": [
          "x"
        ],
        "expected": "x"
      }
    ]
  },
  {
    "id": "bug-max",
    "type": "js-bug",
    "title": "Баг: максимум в массиве",
    "prompt": "findMax должен вернуть наибольшее число. Сейчас логика сломана — почини.",
    "difficulty": "easy",
    "timeLimitSec": 360,
    "starter": "function findMax(nums) {\n  let max = 0;\n  for (const n of nums) {\n    if (n > max) max = n;\n  }\n  return max;\n}\n",
    "functionName": "findMax",
    "tests": [
      {
        "name": "обычный",
        "args": [
          [
            1,
            5,
            3
          ]
        ],
        "expected": 5
      },
      {
        "name": "отрицательные",
        "args": [
          [
            -10,
            -3,
            -7
          ]
        ],
        "expected": -3
      },
      {
        "name": "один",
        "args": [
          [
            42
          ]
        ],
        "expected": 42
      }
    ]
  },
  {
    "id": "bug-even",

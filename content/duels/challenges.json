  {
    "id": "html-card",
    "type": "html-checklist",
    "title": "Карточка товара",
    "prompt": "Сверстай минимальную карточку: article с классом card, внутри h2 с названием, p с ценой, button «Купить».",
    "difficulty": "easy",
    "timeLimitSec": 480,
    "starter": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Карточка</title>\n</head>\n<body>\n  <!-- твоя вёрстка -->\n</body>\n</html>\n",
    "checks": [
      {
        "id": "article-card",
        "description": "есть <article class=\"card\">",
        "pattern": "<article[^>]*class=\"[^\"]*\\bcard\\b"
      },
      {
        "id": "h2",
        "description": "внутри страницы есть h2",
        "pattern": "<h2[\\s>]"
      },
      {
        "id": "price-p",
        "description": "есть абзац p",
        "pattern": "<p[\\s>]"
      },
      {
        "id": "buy-btn",
        "description": "кнопка содержит текст Купить",
        "pattern": "<button[^>]*>\\s*Купить\\s*</button>"
      }
    ]
  },
  {
    "id": "html-form",
    "type": "html-checklist",
    "title": "Форма обратной связи",
    "prompt": "Собери форму: form с input type=email, textarea и button type=submit. У email должен быть required.",
    "difficulty": "easy",
    "timeLimitSec": 480,
    "starter": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Форма</title>\n</head>\n<body>\n  <!-- твоя форма -->\n</body>\n</html>\n",
    "checks": [
      {
        "id": "form",
        "description": "есть form",
        "pattern": "<form[\\s>]"
      },
      {
        "id": "email",
        "description": "есть input type=email",
        "pattern": "<input[^>]*type=\"email\""
      },
      {
        "id": "required",
        "description": "у email есть required",
        "pattern": "<input[^>]*type=\"email\"[^>]*required|<input[^>]*required[^>]*type=\"email\""
      },
      {
        "id": "textarea",
        "description": "есть textarea",
        "pattern": "<textarea[\\s>]"
      },
      {
        "id": "submit",
        "description": "есть button type=submit или input type=submit",
        "pattern": "<button[^>]*type=\"submit\"|<input[^>]*type=\"submit\""
      }
    ]
  },
  {
    "id": "html-landing",
    "type": "html-checklist",
    "title": "Мини-лендинг",
    "prompt": "Сверстай каркас: header с nav из двух ссылок, main с секцией id=\"hero\" и h1, footer с годом 2026.",
    "difficulty": "medium",
    "timeLimitSec": 600,
    "starter": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Лендинг</title>\n</head>\n<body>\n  <!-- header / main / footer -->\n</body>\n</html>\n",
    "checks": [
      {
        "id": "header-nav",
        "description": "header содержит nav",
        "pattern": "<header[\\s\\S]*<nav[\\s\\S]*</nav>[\\s\\S]*</header>"
      },
      {
        "id": "two-links",
        "description": "не меньше двух ссылок <a ",
        "pattern": "(?:<a\\s[^>]*>.*){2}"
      },
      {
        "id": "hero",
        "description": "есть section id=hero",
        "pattern": "<section[^>]*id=\"hero\""
      },
      {
        "id": "h1",
        "description": "есть h1",
        "pattern": "<h1[\\s>]"
      },
      {
        "id": "footer-year",
        "description": "footer содержит 2026",
        "pattern": "<footer[\\s\\S]*2026[\\s\\S]*</footer>"
      }
    ]
  },
  {
